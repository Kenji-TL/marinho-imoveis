# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API Keys)

# URL do projeto, ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (sb_publishable_...). A chave "anon" antiga também funciona aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (sb_secret_...). A chave "service_role" antiga também funciona aqui.
# Usada pelos scripts (npm run admin:criar e npm run seed) e pela tela Equipe do
# painel (criar e remover acessos). Na Vercel, cadastre SEM o prefixo NEXT_PUBLIC_:
# ela fica só no servidor e nunca vai para o navegador.
SUPABASE_SECRET_KEY=

# Endereço do site (sem barra no final). Na Vercel, use o domínio final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
