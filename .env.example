# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API Keys). Serve para rodar no seu computador
# e para os scripts (npm run admin:criar, npm run seed, npm run backup:restaurar).
# Na publicação, os mesmos valores vêm dos segredos do GitHub (veja o README).

# URL do projeto, ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (sb_publishable_...). A chave "anon" antiga também funciona aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (sb_secret_...). A chave "service_role" antiga também funciona aqui.
# Só para os scripts no seu computador. NUNCA use com o prefixo NEXT_PUBLIC_:
# tudo que começa com NEXT_PUBLIC_ vai para o navegador.
SUPABASE_SECRET_KEY=

# Endereço do site (sem barra no final). Na publicação, use o domínio final.
NEXT_PUBLIC_SITE_URL=http://localhost:8787

# Só no `npm run dev`: endereço do serviço do painel (npx wrangler dev, porta 8787).
# No `npm run preview` e na publicação fica vazio (mesmo endereço do site).
NEXT_PUBLIC_API_URL=
